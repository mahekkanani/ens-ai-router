# Sepolia RPC endpoint (e.g. from Alchemy or Infura — no key committed here)
SEPOLIA_RPC_URL=

# OpenAI-compatible LLM settings
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ENS registry name whose agent:index text record lists all active agent ENS names
ENS_REGISTRY_NAME=registry.priya.eth

# Router HTTP server
PORT=3000
